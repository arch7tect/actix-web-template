# Development Environment Configuration
# This is the default configuration for local development
# Copy this to .env: cp .env.example .env
# For other environments, see: .env.test, .env.production

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3737
APP_ENV=development  # Options: development, staging, production (test uses development)

# Logging Configuration
RUST_LOG=info,actix_web=debug,actix_web_template=debug
LOG_FORMAT=pretty

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memos_db
# For tests, see .env.test file or override with:
#   APP_ENV=test DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memos_test
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT=30

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Request Configuration
MAX_REQUEST_SIZE=262144

# API Documentation
ENABLE_SWAGGER=true

# OpenTelemetry / Jaeger Tracing
OTLP_ENDPOINT=http://jaeger:4317